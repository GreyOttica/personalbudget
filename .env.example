# Copia in .env.local (mai su GitHub) e compila.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_…) oppure la legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) oppure la legacy "service_role" key.
# Solo lato server e per lo script di import. Non usarla mai nel browser.
SUPABASE_SECRET_KEY=

# Email con cui fai login: l'app rifiuta tutte le altre.
OWNER_EMAIL=

# Fase 4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Fase 5
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
