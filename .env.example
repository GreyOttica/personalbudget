# Copia in .env.local (mai su GitHub) e compila.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo lato server e per lo script di import. Non usarla mai nel browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email con cui fai login: l'app rifiuta tutte le altre.
OWNER_EMAIL=

# Fase 4
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Fase 5
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
